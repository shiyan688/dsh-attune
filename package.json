{
  "name": "dsh-attune",
  "version": "0.1.0",
  "description": "Small preference experiments for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "https://github.com/shiyan688/dsh-attune.git"
  },
  "homepage": "https://github.com/shiyan688/dsh-attune#readme",
  "bugs": {
    "url": "https://github.com/shiyan688/dsh-attune/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "preferences"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "lib/",
    "docs/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "默契小实验",
      "en": "Attune"
    },
    "icon": "puzzle",
    "contributes": {
      "panels": [
        {
          "id": "attune",
          "title": {
            "zh": "默契",
            "en": "Attune"
          },
          "placement": [
            "chat.panel",
            "features"
          ],
          "presentation": "sheet"
        }
      ],
      "composer.actions": [
        {
          "id": "attune-open",
          "label": {
            "zh": "测默契",
            "en": "Attune"
          },
          "icon": "puzzle",
          "effect": {
            "type": "open",
            "page": "panel:attune"
          }
        }
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-llm": "*"
  }
}
